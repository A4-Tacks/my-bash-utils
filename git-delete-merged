#!/bin/bash
set -o pipefail
set -e
if [ $# != 0 ]; then
    printf '%q: unexpected arg %s\n' "${0##*/}" "${1@Q}" >&2
    exit 2
fi
# NOTE 不要删除远端, 因为这不一定在主分支上, 并且破坏有点大
cur=$(git branch --show-current) || exit
mapfile -t branches < <(
    git remote show | while read -r; do
        remote=$(git rev-parse --abbrev-ref "$REPLY"/HEAD 2>&-)
        echo "${remote#"$REPLY"/}"
    done
)
test ${#branches[*]} != 0

function is_head { # {{{
    for head in "${branches[@]}"; do
        [ "$head" = "$1" ] && return 0
    done
    return 1
} # }}}

if ! is_head "$cur"; then
    read -rN1 -p "${cur@Q} is not a head branch, continue?" ch || exit
    echo
    case "$ch" in
        [yY$'\n']);;
        *) echo exit;exit 1;;
    esac
fi

branches+=("$cur")

git for-each-ref 'refs/heads/*' --merged HEAD --format='%(refname:strip=2)' | while read -r; do
    is_head "$REPLY" && continue
    git branch -d "$REPLY"
done
